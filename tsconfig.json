    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/stories/**",
    "src/**/*.story.*",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/test/**"
  ]
